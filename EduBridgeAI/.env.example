# Copy to .env for local deployment. Never commit real credentials.
APP_BASE_URL=http://localhost:8501
EDUBRIDGE_DB=edubridge.db

# AI course and mind-map generation (Anthropic)
ANTHROPIC_API_KEY=
EDUBRIDGE_AI_MODEL=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# SMTP password-reset email
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=EduBridge AI <no-reply@example.com>

# Razorpay payments (optional until enabled)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
