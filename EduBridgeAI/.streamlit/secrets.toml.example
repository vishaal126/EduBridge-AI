# Copy this file to  .streamlit/secrets.toml  and fill in your values. Never commit secrets.toml.
# Environment variables with the same names work too (they take priority).

# ---- App ----
# Public address of this app, exactly as users open it. No trailing slash.
# It is used as the OAuth redirect URI and inside password-reset emails.
APP_BASE_URL = "http://localhost:8501"

# ---- Google sign-in (see GOOGLE_SETUP.md) ----
GOOGLE_CLIENT_ID = ""
GOOGLE_CLIENT_SECRET = ""

# ---- GitHub sign-in (see GOOGLE_SETUP.md, part 2) ----
GITHUB_CLIENT_ID = ""
GITHUB_CLIENT_SECRET = ""

# ---- Password-reset email (any SMTP provider) ----
SMTP_HOST = ""                       # e.g. smtp.gmail.com
SMTP_PORT = "587"                    # 587 = STARTTLS, 465 = SSL
SMTP_USERNAME = ""
SMTP_PASSWORD = ""                   # for Gmail use an App Password
SMTP_FROM = "EduBridge AI <no-reply@yourdomain.com>"
# SMTP_STARTTLS = "true"

# ---- Existing settings ----
ANTHROPIC_API_KEY = "sk-ant-..."
# EDUBRIDGE_AI_MODEL = "claude-sonnet-5-5"
# RAZORPAY_KEY_ID = "rzp_test_..."
# RAZORPAY_KEY_SECRET = "..."
